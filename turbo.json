{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "generate": {
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/docs/design-tokens.json"],
      "outputs": ["generated/**"]
    },
    "build": {
      "dependsOn": ["^build", "^generate", "generate"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "dev": {
      "dependsOn": ["^generate"],
      "cache": false,
      "persistent": true
    },
    "lint": {},
    "typecheck": {
      "dependsOn": ["^generate", "generate"]
    },
    "test": {
      "dependsOn": ["^generate", "generate"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/docs/design-tokens.json"]
    }
  }
}
