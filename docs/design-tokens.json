          "text-muted": "{palette.ink.500}",
          "text-inverse": "{palette.white}",
          "focus-ring": "{palette.emerald.600}",
          "overlay": "rgba(11,31,51,0.48)",
          "chart-paid": "{palette.ink.900}",
          "chart-best": "{palette.emerald.700}",
          "chart-deal": "{palette.coral.500}",
          "chart-grid": "{palette.ink.200}",
          "chart-series": [
            "#047857",
            "#0369A1",
            "#7C3AED",
