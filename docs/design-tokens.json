      "light": {
        "color": {
          "primary": "{palette.emerald.700}",
          "primary-hover": "{palette.emerald.800}",
          "primary-subtle": "{palette.emerald.100}",
          "on-primary": "{palette.white}",
          "on-primary-subtle": "{palette.emerald.800}",
          "accent": "{palette.coral.500}",
          "accent-hover": "{palette.coral.400}",
          "on-accent": "{palette.coral.950}",
          "accent-text": "{palette.coral.700}",
          "savings": "{palette.emerald.700}",
          "savings-subtle": "{palette.emerald.100}",
          "warning": "{palette.amber.700}",
          "warning-subtle": "{palette.amber.100}",
          "on-warning-subtle": "#854D0E",
          "danger": "{palette.red.700}",
          "danger-subtle": "{palette.red.100}",
