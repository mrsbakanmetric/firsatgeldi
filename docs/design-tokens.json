      "500": "#FF5A36",
      "700": "#C73A1C",
      "950": "#1A0A05"
    },
    "ink": {
      "50": "#F7FAF9",
      "100": "#EEF4F2",
      "200": "#DCE5E1",
      "500": "#4A5D6E",
      "300": "#9FB3C4",
      "700": "#24384B",
      "800": "#16293B",
      "850": "#0E1E2E",
      "900": "#0B1F33",
      "950": "#07131F"
