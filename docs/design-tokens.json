{
  "$meta": {
    "name": "FırsatGeldi Design Tokens",
    "version": "1.6.0",
    "updated": "2026-11-12",
    "activeTheme": "firsatgeldi-default",
    "rule": "SINGLE SOURCE OF TRUTH for every visual value in web and mobile. Never hard-code colours, font sizes, spacing, radius, borders or shadows in code. Read this file before creating or changing ANY UI element (screen, button, text, heading, divider, card, badge, input, icon, chart, notification, email).",
    "contrastStandard": "WCAG 2.1 AA: 4.5:1 normal text, 3:1 large text (>=18.66px bold or >=24px) and UI parts"
  },
  "palette": {
