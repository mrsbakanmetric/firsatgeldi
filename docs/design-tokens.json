      "50": "#ECFDF5",
      "100": "#D1FAE5",
      "300": "#6EE7B7",
      "400": "#34D399",
      "600": "#059669",
      "700": "#047857",
      "800": "#065F46",
      "950": "#052E22"
    },
    "coral": {
      "300": "#FFA48F",
