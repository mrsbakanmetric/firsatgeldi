            "#BE185D",
            "#4A5D6E"
          ],
          "stock-in": "{palette.emerald.700}",
          "stock-low": "{palette.amber.400}",
          "stock-low-border": "{palette.amber.700}",
          "stock-out-border": "{palette.red.700}",
          "stock-out-fill": "{palette.white}",
          "hero-surface": "{palette.ink.900}",
