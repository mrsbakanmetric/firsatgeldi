          "on-primary-subtle": "{palette.emerald.300}",
          "accent": "{palette.coral.400}",
          "accent-hover": "{palette.coral.300}",
          "on-accent": "{palette.coral.950}",
          "accent-text": "{palette.coral.400}",
          "savings": "{palette.emerald.400}",
          "savings-subtle": "#0F3A2C",
          "warning": "{palette.amber.400}",
          "warning-subtle": "#3A2E0B",
          "on-warning-subtle": "{palette.amber.300}",
          "danger": "{palette.red.400}",
          "danger-subtle": "#3B1416",
          "info": "{palette.sky.400}",
          "info-subtle": "#0B2A3D",
          "background": "{palette.ink.950}",
          "surface": "{palette.ink.850}",
          "surface-alt": "{palette.ink.800}",
          "border": "{palette.ink.700}",
          "divider": "{palette.ink.700}",
          "text": "{palette.ink.100}",
          "text-muted": "{palette.ink.300}",
          "text-inverse": "{palette.ink.900}",
          "focus-ring": "{palette.emerald.300}",
          "overlay": "rgba(0,0,0,0.6)",
          "chart-paid": "{palette.ink.100}",
          "chart-best": "{palette.emerald.400}",
          "chart-deal": "{palette.coral.400}",
          "chart-grid": "{palette.ink.700}",
          "chart-series": [
            "#34D399",
            "#38BDF8",
            "#A78BFA",
            "#FBBF24",
            "#F472B6",
            "#9FB3C4"
          ],
          "stock-in": "{palette.emerald.400}",
          "stock-low": "{palette.amber.400}",
          "stock-low-border": "{palette.amber.400}",
          "stock-out-border": "{palette.red.400}",
          "stock-out-fill": "{palette.ink.850}",
          "hero-surface": "{palette.ink.800}",
          "on-hero-surface": "{palette.ink.100}",
          "on-hero-muted": "{palette.ink.300}",
          "hero-savings": "{palette.emerald.300}",
          "hero-line": "{palette.ink.700}",
